"KeepCSVFile","off"
"CreateFormattedReport","on"
"CreateAppwareData","off"
"FCC","on"
"Paging","on","68","Page"
"Date","on","Date"
"Header","Summary of cut pipe lengths for project number -"
"ProjectNumber","on"
"Pipelist","on","For Pipeline References"
"Metric","lengths","(metres)","bores","(mm)"
"Imperial","lengths","(ft & ins)","bores","(ins)"
"Subtotal","SUB TOTAL"
"Column","Itemcode","Title1","Item","Title2","Code","Width","12","Space","2"
"Column","Description","Title1","Item Description and Specification","Title2","","Width","38","Space","3"
"Column","Size","Title1","Size","Title2","<Units>","Width","7","Space","2"
"Column","Length","Title1","Cut Length","Title2","<Units>","Width","10","Space","2"
"Column","TruLength","Title1","Length","Title2","<Units>","Width","10","Space","2"
"Column","Specreq","Title1","Special","Title2","Req.","Width","9","Space","1"
"Column","Pieceno","Title1","Piece","Title2","No.","Width","5","Space","2"
"Column","Piecename","Title1","Piece","Title2","No.","Width","14","Space","2"
"Column","Pipename","Title1","Pipeline","Title2","Reference","Width","18","Space","2"
"Column","Batchref","Title1","Batch","Title2","Reference","Width","18","Space","0"
